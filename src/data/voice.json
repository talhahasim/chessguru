    "file": "voice/siberian-trap/takeaway-1-1103cbed.mp3",
    "seconds": 1.635
   },
   "takeaway-2": {
    "text": "Attack two things at once.",
    "file": "voice/siberian-trap/takeaway-2-cd1200a8.mp3",
    "seconds": 1.358
   },
   "cta": {
    "text": "Follow for more traps!",
