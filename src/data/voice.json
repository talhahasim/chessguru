   },
   "step-7": {
    "text": "Bishop takes f2. Check!",
    "file": "voice/stafford-trap/step-7-76d20fbd.mp3",
    "seconds": 1.719
   },
   "step-8": {
    "text": "The king has only one square.",
    "file": "voice/stafford-trap/step-8-fe15ac0c.mp3",
    "seconds": 1.609
   },
   "step-9": {
    "text": "Bishop to g4. Checkmate!",
    "file": "voice/stafford-trap/step-9-29893e9c.mp3",
    "seconds": 1.949
   },
   "finale": {
    "text": "Checkmate! Black wins.",
    "file": "voice/stafford-trap/finale-bd5a32ad.mp3",
    "seconds": 1.369
   },
   "remember": {
    "text": "Remember!",
    "file": "voice/stafford-trap/remember-267df169.mp3",
    "seconds": 0.633
   },
   "takeaway-0": {
    "text": "Bishop on c5 means pressure on f2.",
    "file": "voice/stafford-trap/takeaway-0-d8e23398.mp3",
    "seconds": 2.456
   },
   "takeaway-1": {
    "text": "Pinned to the queen? You can still move.",
    "file": "voice/stafford-trap/takeaway-1-ef161fd6.mp3",
    "seconds": 2.163
   },
   "takeaway-2": {
    "text": "Before taking a queen, check for checks.",
    "file": "voice/stafford-trap/takeaway-2-34774027.mp3",
    "seconds": 2.174
   },
   "cta": {
    "text": "Follow for more traps!",
    "file": "voice/stafford-trap/cta-fd3186ce.mp3",
    "seconds": 1.326
   }
  },
  "englund-gambit-trap": {
   "hook": {
    "text": "White takes a free pawn. 6 moves later: Checkmate.",
    "file": "voice/englund-gambit-trap/hook-04e16a42.mp3",
    "seconds": 3.228
   },
   "intro": {
    "text": "Englund Gambit Trap!",
    "file": "voice/englund-gambit-trap/intro-42d80bfb.mp3",
    "seconds": 1.281
   },
   "step-0": {
    "text": "We throw a pawn at them. The Englund Gambit.",
    "file": "voice/englund-gambit-trap/step-0-4d371633.mp3",
    "seconds": 2.463
   },
   "step-1": {
    "text": "White takes and protects it.",
    "file": "voice/englund-gambit-trap/step-1-0c0e8ad6.mp3",
