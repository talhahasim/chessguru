    "seconds": 1.924
   },
   "finale": {
    "text": "Checkmate! Black wins.",
    "file": "voice/siberian-trap/finale-bd5a32ad.mp3",
    "seconds": 1.369
   },
   "remember": {
    "text": "Remember!",
    "file": "voice/siberian-trap/remember-267df169.mp3",
