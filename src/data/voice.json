{
 "engine": "Kokoro-82M v1.0 (kokoro-onnx)",
 "voice": "af_heart",
 "speed": 1,
 "lessons": {
  "scholars-mate": {
   "hook": {
    "text": "Checkmate in 4 moves. Beginners fall for this all the time.",
    "file": "voice/scholars-mate/hook-1c16c82c.mp3",
    "seconds": 3.302
   },
   "intro": {
    "text": "Scholar's Mate!",
    "file": "voice/scholars-mate/intro-816c5f14.mp3",
    "seconds": 0.949
   },
   "step-0": {
    "text": "Pawn to e4. This opens the door for our queen and bishop.",
    "file": "voice/scholars-mate/step-0-cada4776.mp3",
    "seconds": 3.477
   },
   "step-1": {
    "text": "Black copies us. Totally normal.",
    "file": "voice/scholars-mate/step-1-e0e94b88.mp3",
    "seconds": 1.871
   },
   "step-2": {
    "text": "Bishop out. It's aiming at f7.",
    "file": "voice/scholars-mate/step-2-0e9e56b0.mp3",
    "seconds": 2.155
   },
   "step-3": {
    "text": "Look at f7. Only the king protects it. That's the weak spot!",
    "file": "voice/scholars-mate/step-3-fd89705a.mp3",
    "seconds": 3.73
   },
   "step-4": {
    "text": "Black brings out a knight. Looks fine...",
    "file": "voice/scholars-mate/step-4-6476cf84.mp3",
    "seconds": 1.916
   },
   "step-5": {
    "text": "Queen out! Now two pieces attack f7.",
    "file": "voice/scholars-mate/step-5-3e3c4fba.mp3",
    "seconds": 2.474
   },
   "step-6": {
    "text": "Black attacks our queen... But forgets about f7!",
    "file": "voice/scholars-mate/step-6-2623ec97.mp3",
    "seconds": 2.991
   },
   "step-7": {
    "text": "Queen takes f7. The bishop protects her. Checkmate!",
    "file": "voice/scholars-mate/step-7-597e4811.mp3",
    "seconds": 3.264
   },
   "finale": {
    "text": "Checkmate! White wins.",
    "file": "voice/scholars-mate/finale-8efa32fa.mp3",
    "seconds": 1.343
   },
   "remember": {
    "text": "Remember!",
    "file": "voice/scholars-mate/remember-267df169.mp3",
    "seconds": 0.633
   },
   "takeaway-0": {
    "text": "Queen and bishop attack f7.",
    "file": "voice/scholars-mate/takeaway-0-4be388f6.mp3",
    "seconds": 1.873
   },
   "takeaway-1": {
    "text": "If they forget to defend it: Game over.",
    "file": "voice/scholars-mate/takeaway-1-0e18ca28.mp3",
    "seconds": 2.179
   },
   "takeaway-2": {
    "text": "Playing Black? Stop it with g6 or queen e7.",
    "file": "voice/scholars-mate/takeaway-2-0f269807.mp3",
    "seconds": 3.241
   },
   "cta": {
    "text": "Follow for more traps!",
    "file": "voice/scholars-mate/cta-fd3186ce.mp3",
    "seconds": 1.326
   }
  },
  "fools-mate": {
   "hook": {
    "text": "The fastest checkmate in chess. Only 2 moves. Seriously.",
    "file": "voice/fools-mate/hook-9f48e79e.mp3",
    "seconds": 3.629
   },
   "intro": {
    "text": "Fool's Mate!",
    "file": "voice/fools-mate/intro-ad0c5b2a.mp3",
    "seconds": 0.854
   },
   "step-0": {
    "text": "White pushes the f-pawn. That pawn was guarding the king.",
    "file": "voice/fools-mate/step-0-3e7bc008.mp3",
    "seconds": 3.128
   },
   "step-1": {
    "text": "We push our pawn. Now our queen can come out.",
    "file": "voice/fools-mate/step-1-5c0b90e2.mp3",
    "seconds": 2.507
   },
   "step-2": {
    "text": "White pushes another pawn. Huge mistake.",
    "file": "voice/fools-mate/step-2-36181263.mp3",
    "seconds": 2.529
   },
   "step-3": {
    "text": "Look at this line to the king. Nothing is blocking it!",
    "file": "voice/fools-mate/step-3-1c4c30c6.mp3",
    "seconds": 2.799
   },
   "step-4": {
    "text": "Queen to h4. The king is trapped. Checkmate!",
    "file": "voice/fools-mate/step-4-829756e2.mp3",
    "seconds": 2.814
   },
   "finale": {
    "text": "Checkmate! Black wins.",
    "file": "voice/fools-mate/finale-bd5a32ad.mp3",
    "seconds": 1.369
   },
   "remember": {
    "text": "Remember!",
    "file": "voice/fools-mate/remember-267df169.mp3",
    "seconds": 0.633
   },
   "takeaway-0": {
    "text": "Don't push your f and g pawns early.",
    "file": "voice/fools-mate/takeaway-0-ecd58447.mp3",
    "seconds": 2.087
   },
   "takeaway-1": {
    "text": "They are your king's bodyguards.",
    "file": "voice/fools-mate/takeaway-1-1aa86c4d.mp3",
    "seconds": 1.596
   },
   "takeaway-2": {
    "text": "Open line to the king means danger.",
    "file": "voice/fools-mate/takeaway-2-4c8e461d.mp3",
    "seconds": 2.009
   },
   "cta": {
    "text": "Follow for more traps!",
    "file": "voice/fools-mate/cta-fd3186ce.mp3",
    "seconds": 1.326
   }
  },
  "back-rank-mate": {
   "hook": {
    "text": "They have a queen. We have a rook. We still win in 1 move.",
    "file": "voice/back-rank-mate/hook-17707f96.mp3",
    "seconds": 3.027
   },
   "intro": {
    "text": "Back Rank Mate!",
    "file": "voice/back-rank-mate/intro-2f5fa10c.mp3",
    "seconds": 0.929
   },
   "step-0": {
    "text": "Black has a queen. Black is winning... Right?",
    "file": "voice/back-rank-mate/step-0-b4af7295.mp3",
    "seconds": 2.507
   },
   "step-1": {
    "text": "Look at their king. It's stuck behind its own pawns. No exit!",
    "file": "voice/back-rank-mate/step-1-ecbcce39.mp3",
    "seconds": 3.414
   },
   "step-2": {
    "text": "Black gets greedy and grabs a pawn.",
    "file": "voice/back-rank-mate/step-2-24e3680f.mp3",
    "seconds": 1.997
   },
   "step-3": {
    "text": "Rook to the back row. The king can't escape. Checkmate!",
    "file": "voice/back-rank-mate/step-3-066c016a.mp3",
    "seconds": 3.157
   },
   "finale": {
    "text": "Checkmate! A rook beat a queen.",
    "file": "voice/back-rank-mate/finale-36fe07c4.mp3",
    "seconds": 1.747
   },
   "remember": {
    "text": "Remember!",
    "file": "voice/back-rank-mate/remember-267df169.mp3",
    "seconds": 0.633
   },
   "takeaway-0": {
    "text": "King with no exit squares? Look at the back row.",
    "file": "voice/back-rank-mate/takeaway-0-54f4e77b.mp3",
    "seconds": 2.679
   },
   "takeaway-1": {
    "text": "One rook can end the game.",
    "file": "voice/back-rank-mate/takeaway-1-4b3071b1.mp3",
    "seconds": 1.357
   },
   "takeaway-2": {
    "text": "Protect yourself: Give your king one free square (like h6).",
    "file": "voice/back-rank-mate/takeaway-2-37aeb2d0.mp3",
    "seconds": 3.678
   },
   "cta": {
    "text": "Follow for more traps!",
    "file": "voice/back-rank-mate/cta-fd3186ce.mp3",
    "seconds": 1.326
   }
  },
  "legals-mate": {
   "hook": {
    "text": "Give away your queen... And checkmate 2 moves later.",
    "file": "voice/legals-mate/hook-efff6600.mp3",
    "seconds": 2.724
   },
   "intro": {
    "text": "Lay-gahl's Mate!",
    "file": "voice/legals-mate/intro-cf16379e.mp3",
    "seconds": 1.008
   },
   "step-0": {
    "text": "Normal start. Our knight attacks e5.",
    "file": "voice/legals-mate/step-0-bd9a65d0.mp3",
    "seconds": 2.489
   },
   "step-1": {
    "text": "Black protects it with a pawn.",
    "file": "voice/legals-mate/step-1-8178041f.mp3",
    "seconds": 1.473
   },
   "step-2": {
    "text": "Bishop out. Aiming at f7, the weak spot.",
    "file": "voice/legals-mate/step-2-2d4f10ce.mp3",
    "seconds": 2.686
   },
   "step-3": {
    "text": "Black pins our knight. 'If it moves, I take your queen!'",
    "file": "voice/legals-mate/step-3-04270d96.mp3",
    "seconds": 2.852
   },
   "step-4": {
    "text": "We bring out a piece. Black plays a slow move. Now the trap is ready.",
    "file": "voice/legals-mate/step-4-9fa9ac35.mp3",
    "seconds": 3.937
   },
   "step-5": {
    "text": "Knight takes e5! We leave our queen to die!",
    "file": "voice/legals-mate/step-5-1608e378.mp3",
    "seconds": 2.5
   },
   "step-6": {
    "text": "Black grabs the queen. Big mistake.",
    "file": "voice/legals-mate/step-6-41a16645.mp3",
    "seconds": 2.274
   },
   "step-7": {
    "text": "Bishop takes f7. Check!",
    "file": "voice/legals-mate/step-7-9262310c.mp3",
    "seconds": 1.88
   },
   "step-8": {
    "text": "The king has only one square to go.",
    "file": "voice/legals-mate/step-8-bd4e90a0.mp3",
    "seconds": 2.017
   },
   "step-9": {
    "text": "Knight to d5. Checkmate! Three small pieces beat a queen.",
    "file": "voice/legals-mate/step-9-3343779a.mp3",
    "seconds": 3.804
   },
   "finale": {
    "text": "Checkmate! White wins.",
    "file": "voice/legals-mate/finale-8efa32fa.mp3",
    "seconds": 1.343
   },
   "remember": {
    "text": "Remember!",
    "file": "voice/legals-mate/remember-267df169.mp3",
    "seconds": 0.633
   },
   "takeaway-0": {
    "text": "A pin to the queen is not a real pin.",
    "file": "voice/legals-mate/takeaway-0-0ea391dd.mp3",
    "seconds": 2.132
   },
   "takeaway-1": {
    "text": "Sometimes giving the queen wins the game.",
    "file": "voice/legals-mate/takeaway-1-f10effd0.mp3",
    "seconds": 2.168
   },
   "takeaway-2": {
    "text": "Free queen? First check for checkmate.",
    "file": "voice/legals-mate/takeaway-2-820b74a3.mp3",
    "seconds": 2.187
   },
   "cta": {
    "text": "Follow for more traps!",
    "file": "voice/legals-mate/cta-fd3186ce.mp3",
    "seconds": 1.326
   }
  },
  "blackburne-shilling": {
   "hook": {
    "text": "This move looks like a blunder... But it ends in checkmate.",
    "file": "voice/blackburne-shilling/hook-147f4ca7.mp3",
    "seconds": 3.162
   },
   "intro": {
    "text": "Blackburne Shilling Trap!",
    "file": "voice/blackburne-shilling/intro-77a32960.mp3",
    "seconds": 1.316
   },
   "step-0": {
    "text": "Normal opening. White's bishop eyes f7.",
    "file": "voice/blackburne-shilling/step-0-f730c9cc.mp3",
    "seconds": 2.886
   },
   "step-1": {
    "text": "Knight to d4. Risky! Now our e5 pawn looks free.",
    "file": "voice/blackburne-shilling/step-1-0f9562fd.mp3",
    "seconds": 3.85
   },
   "step-2": {
    "text": "White takes the free pawn. Here we go.",
    "file": "voice/blackburne-shilling/step-2-2a818e2c.mp3",
    "seconds": 2.202
   },
   "step-3": {
    "text": "Queen to g5! She attacks the knight and the g2 pawn.",
    "file": "voice/blackburne-shilling/step-3-3fdab55d.mp3",
    "seconds": 3.564
   },
   "step-4": {
    "text": "White gets greedy. Knight takes f7, hitting our rook.",
    "file": "voice/blackburne-shilling/step-4-4348c974.mp3",
    "seconds": 3.335
   },
   "step-5": {
    "text": "We don't care! Queen takes g2. Now their rook is attacked.",
    "file": "voice/blackburne-shilling/step-5-2a769627.mp3",
    "seconds": 3.591
   },
   "step-6": {
    "text": "White saves the rook.",
    "file": "voice/blackburne-shilling/step-6-db8b522c.mp3",
    "seconds": 1.161
   },
   "step-7": {
    "text": "Queen takes e4. Check!",
    "file": "voice/blackburne-shilling/step-7-e122f729.mp3",
    "seconds": 1.716
   },
   "step-8": {
    "text": "White blocks with the bishop.",
    "file": "voice/blackburne-shilling/step-8-b98969ef.mp3",
    "seconds": 1.451
   },
   "step-9": {
    "text": "Knight to f3. The bishop can't take: It's pinned. Checkmate!",
    "file": "voice/blackburne-shilling/step-9-3bba19b6.mp3",
    "seconds": 3.593
   },
   "finale": {
    "text": "Checkmate! Black wins.",
    "file": "voice/blackburne-shilling/finale-bd5a32ad.mp3",
    "seconds": 1.369
   },
   "remember": {
    "text": "Remember!",
    "file": "voice/blackburne-shilling/remember-267df169.mp3",
    "seconds": 0.633
   },
   "takeaway-0": {
    "text": "If they grab e5, play queen g5!",
    "file": "voice/blackburne-shilling/takeaway-0-bd717516.mp3",
    "seconds": 2.523
   },
   "takeaway-1": {
    "text": "Ignore the knight. Attack g2.",
    "file": "voice/blackburne-shilling/takeaway-1-dc2ec6ce.mp3",
    "seconds": 2.078
   },
   "takeaway-2": {
    "text": "Knight d4 is risky. It works when they grab e5.",
    "file": "voice/blackburne-shilling/takeaway-2-e4b55a13.mp3",
    "seconds": 3.409
   },
   "cta": {
    "text": "Follow for more traps!",
    "file": "voice/blackburne-shilling/cta-fd3186ce.mp3",
    "seconds": 1.326
   }
  },
  "stafford-trap": {
   "hook": {
    "text": "White takes our queen... And gets checkmated right away.",
    "file": "voice/stafford-trap/hook-5c546ff6.mp3",
