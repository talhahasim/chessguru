  "elephant-trap": {
   "hook": {
    "text": "White thinks they won a pawn. Really, they just lost a piece.",
    "file": "voice/elephant-trap/hook-17024e4c.mp3",
    "seconds": 3.28
   },
   "intro": {
    "text": "Elephant Trap!",
    "file": "voice/elephant-trap/intro-03a7aa27.mp3",
    "seconds": 0.892
   },
   "step-0": {
    "text": "The Queen's Gambit. Very normal stuff.",
    "file": "voice/elephant-trap/step-0-d27e29d1.mp3",
    "seconds": 2.185
   },
   "step-1": {
    "text": "White pins our knight to the queen.",
    "file": "voice/elephant-trap/step-1-d3f916de.mp3",
    "seconds": 1.622
   },
   "step-2": {
    "text": "Knight to d7. This quietly sets the trap.",
    "file": "voice/elephant-trap/step-2-d9c525ef.mp3",
    "seconds": 2.76
   },
   "step-3": {
    "text": "Pawns trade on d5.",
    "file": "voice/elephant-trap/step-3-0728f094.mp3",
    "seconds": 1.468
   },
   "step-4": {
    "text": "White grabs d5. 'Your knight is pinned!' they think.",
    "file": "voice/elephant-trap/step-4-462ff25e.mp3",
    "seconds": 2.95
   },
   "step-5": {
    "text": "Surprise! We take anyway and give our queen.",
    "file": "voice/elephant-trap/step-5-6b67e153.mp3",
    "seconds": 2.445
   },
   "step-6": {
    "text": "White takes the queen.",
    "file": "voice/elephant-trap/step-6-cd1ed93e.mp3",
    "seconds": 1.156
   },
   "step-7": {
    "text": "Bishop check! White must block.",
    "file": "voice/elephant-trap/step-7-2f0c22f0.mp3",
    "seconds": 1.671
   },
   "step-8": {
    "text": "Only the queen can block.",
    "file": "voice/elephant-trap/step-8-ba2fb12f.mp3",
    "seconds": 1.373
   },
   "step-9": {
    "text": "We take their queen with check.",
    "file": "voice/elephant-trap/step-9-89cc233d.mp3",
    "seconds": 1.348
   },
   "step-10": {
    "text": "And we take the bishop. We're a whole piece up!",
    "file": "voice/elephant-trap/step-10-e4902b38.mp3",
    "seconds": 2.355
   },
   "finale": {
    "text": "Piece won! Black is a whole piece up.",
    "file": "voice/elephant-trap/finale-552723c8.mp3",
    "seconds": 2.059
   },
   "remember": {
    "text": "Remember!",
    "file": "voice/elephant-trap/remember-267df169.mp3",
    "seconds": 0.633
   },
   "takeaway-0": {
    "text": "A pinned knight can still move.",
    "file": "voice/elephant-trap/takeaway-0-9991c155.mp3",
    "seconds": 1.495
   },
   "takeaway-1": {
    "text": "Lose your queen, take theirs and a piece.",
    "file": "voice/elephant-trap/takeaway-1-e9eea26e.mp3",
    "seconds": 2.088
   },
   "takeaway-2": {
    "text": "Free pawn? Count the checks first.",
    "file": "voice/elephant-trap/takeaway-2-33c66f8f.mp3",
    "seconds": 1.883
   },
   "cta": {
    "text": "Follow for more traps!",
    "file": "voice/elephant-trap/cta-fd3186ce.mp3",
    "seconds": 1.326
   }
  },
  "kieninger-trap": {
   "hook": {
    "text": "White takes our bishop. Next move: Checkmate.",
    "file": "voice/kieninger-trap/hook-dd55cae2.mp3",
    "seconds": 2.596
   },
   "intro": {
    "text": "Kee-ning-er Trap!",
    "file": "voice/kieninger-trap/intro-134f6bf4.mp3",
    "seconds": 0.963
   },
   "step-0": {
    "text": "We give a pawn. The Budapest Gambit.",
    "file": "voice/kieninger-trap/step-0-9ef1fe18.mp3",
    "seconds": 2.091
   },
   "step-1": {
    "text": "Our knights attack e5.",
    "file": "voice/kieninger-trap/step-1-ea8e4319.mp3",
    "seconds": 1.459
   },
   "step-2": {
    "text": "White protects it with the bishop.",
    "file": "voice/kieninger-trap/step-2-4440fef1.mp3",
    "seconds": 1.579
   },
   "step-3": {
    "text": "Bishop check!",
    "file": "voice/kieninger-trap/step-3-2a03275c.mp3",
    "seconds": 0.822
   },
   "step-4": {
    "text": "White blocks with the knight.",
    "file": "voice/kieninger-trap/step-4-536bfacb.mp3",
    "seconds": 1.389
   },
   "step-5": {
    "text": "Queen to e7. Now three pieces hit e5.",
    "file": "voice/kieninger-trap/step-5-39a08e97.mp3",
    "seconds": 3.043
   },
   "step-6": {
    "text": "White attacks our bishop.",
    "file": "voice/kieninger-trap/step-6-0384c097.mp3",
    "seconds": 1.315
   },
   "step-7": {
    "text": "We ignore it and take e5! Leave the bishop.",
    "file": "voice/kieninger-trap/step-7-befe9837.mp3",
    "seconds": 2.517
   },
   "step-8": {
    "text": "White takes the free bishop...",
    "file": "voice/kieninger-trap/step-8-91768283.mp3",
    "seconds": 1.421
   },
   "step-9": {
    "text": "Look: The e2 pawn is pinned. The king is boxed in.",
    "file": "voice/kieninger-trap/step-9-350bd8f2.mp3",
    "seconds": 3.078
   },
   "step-10": {
    "text": "Knight to d3. Smothered checkmate!",
    "file": "voice/kieninger-trap/step-10-3f1cbecc.mp3",
    "seconds": 2.243
   },
   "finale": {
    "text": "Checkmate! Black wins.",
    "file": "voice/kieninger-trap/finale-bd5a32ad.mp3",
    "seconds": 1.369
   },
   "remember": {
    "text": "Remember!",
    "file": "voice/kieninger-trap/remember-267df169.mp3",
    "seconds": 0.633
   },
   "takeaway-0": {
    "text": "Pin the e2 pawn with your queen.",
    "file": "voice/kieninger-trap/takeaway-0-190beba8.mp3",
    "seconds": 1.715
   },
   "takeaway-1": {
    "text": "King boxed in by its own pieces means knight mate.",
    "file": "voice/kieninger-trap/takeaway-1-0856e6b7.mp3",
    "seconds": 2.68
   },
   "takeaway-2": {
    "text": "Free bishop? Check for mate first.",
    "file": "voice/kieninger-trap/takeaway-2-b7fea431.mp3",
    "seconds": 1.886
   },
   "cta": {
    "text": "Follow for more traps!",
    "file": "voice/kieninger-trap/cta-fd3186ce.mp3",
    "seconds": 1.326
   }
  },
  "lasker-trap": {
   "hook": {
    "text": "Promote a pawn to a knight? Yes. And it wins the queen.",
    "file": "voice/lasker-trap/hook-3ffbf9bb.mp3",
    "seconds": 3.084
   },
   "intro": {
    "text": "Lasker Trap!",
    "file": "voice/lasker-trap/intro-eb1f8603.mp3",
    "seconds": 0.935
   },
   "step-0": {
    "text": "We give a pawn. The Albin Countergambit.",
    "file": "voice/lasker-trap/step-0-0b5e558b.mp3",
    "seconds": 2.347
   },
   "step-1": {
    "text": "Our pawn pushes forward. Annoying for White.",
    "file": "voice/lasker-trap/step-1-22426ce5.mp3",
    "seconds": 2.633
   },
   "step-2": {
    "text": "White attacks it. This is the mistake.",
    "file": "voice/lasker-trap/step-2-b676a66b.mp3",
    "seconds": 2.14
   },
   "step-3": {
    "text": "Bishop check!",
    "file": "voice/lasker-trap/step-3-2a03275c.mp3",
    "seconds": 0.822
   },
   "step-4": {
    "text": "We take on e3. Now we hit f2 and the bishop.",
    "file": "voice/lasker-trap/step-4-ba1dcf77.mp3",
    "seconds": 3.128
   },
   "step-5": {
    "text": "White takes our bishop. Big mistake.",
    "file": "voice/lasker-trap/step-5-26a7c709.mp3",
    "seconds": 2.183
   },
   "step-6": {
    "text": "Pawn takes f2. Check!",
    "file": "voice/lasker-trap/step-6-13691ac4.mp3",
    "seconds": 1.741
   },
   "step-7": {
    "text": "The king must move.",
    "file": "voice/lasker-trap/step-7-2f511dc7.mp3",
    "seconds": 1.065
   },
   "step-8": {
    "text": "Pawn takes the knight and becomes... A knight! With check!",
    "file": "voice/lasker-trap/step-8-9d38e27f.mp3",
    "seconds": 3.054
   },
   "step-9": {
    "text": "Why a knight? A queen gives no check. The knight does.",
    "file": "voice/lasker-trap/step-9-e8bf1416.mp3",
    "seconds": 2.717
   },
   "step-10": {
    "text": "White takes our new knight.",
    "file": "voice/lasker-trap/step-10-b1fa3380.mp3",
    "seconds": 1.291
   },
   "step-11": {
    "text": "Bishop check! And it hits the queen.",
    "file": "voice/lasker-trap/step-11-2731eb39.mp3",
    "seconds": 1.821
   },
   "step-12": {
    "text": "The king steps back... And we take their queen!",
    "file": "voice/lasker-trap/step-12-0428b129.mp3",
    "seconds": 2.364
   },
   "finale": {
    "text": "Queen won! Thanks to a knight promotion.",
    "file": "voice/lasker-trap/finale-6c2b858b.mp3",
    "seconds": 2.188
   },
   "remember": {
    "text": "Remember!",
    "file": "voice/lasker-trap/remember-267df169.mp3",
    "seconds": 0.633
   },
   "takeaway-0": {
    "text": "Promote to a knight when it gives check.",
    "file": "voice/lasker-trap/takeaway-0-88c26080.mp3",
    "seconds": 1.671
   },
   "takeaway-1": {
    "text": "Checks first, captures second.",
    "file": "voice/lasker-trap/takeaway-1-a6cb726a.mp3",
    "seconds": 1.699
   },
   "takeaway-2": {
    "text": "Against the Albin, avoid e3.",
    "file": "voice/lasker-trap/takeaway-2-96732a4d.mp3",
    "seconds": 1.988
   },
   "cta": {
    "text": "Follow for more traps!",
    "file": "voice/lasker-trap/cta-fd3186ce.mp3",
    "seconds": 1.326
   }
  },
  "fishing-pole-trap": {
   "hook": {
    "text": "Throw your knight as bait... And catch a checkmate.",
    "file": "voice/fishing-pole-trap/hook-eea5f902.mp3",
    "seconds": 2.462
   },
   "intro": {
    "text": "Fishing Pole Trap!",
    "file": "voice/fishing-pole-trap/intro-ba01950b.mp3",
    "seconds": 1.158
   },
   "step-0": {
    "text": "The Roo-ee Lopez. White castles. Very normal.",
    "file": "voice/fishing-pole-trap/step-0-cd087019.mp3",
    "seconds": 2.878
   },
   "step-1": {
    "text": "Knight to g4. Risky... But it's our fishing pole!",
    "file": "voice/fishing-pole-trap/step-1-c32e26d1.mp3",
    "seconds": 3.19
   },
   "step-2": {
    "text": "White kicks the knight.",
    "file": "voice/fishing-pole-trap/step-2-cd69f536.mp3",
    "seconds": 1.146
   },
   "step-3": {
    "text": "We leave it there. The knight is the bait.",
    "file": "voice/fishing-pole-trap/step-3-2cedc3e8.mp3",
    "seconds": 2.117
   },
   "step-4": {
    "text": "White takes the free knight...",
    "file": "voice/fishing-pole-trap/step-4-56eca5c1.mp3",
    "seconds": 1.357
   },
   "step-5": {
    "text": "We take back. Now the h-file is wide open.",
    "file": "voice/fishing-pole-trap/step-5-82347fa9.mp3",
    "seconds": 2.796
   },
   "step-6": {
    "text": "The knight runs away.",
    "file": "voice/fishing-pole-trap/step-6-3c73ec81.mp3",
    "seconds": 1.189
   },
   "step-7": {
    "text": "Queen to h4. Threat: Queen to h1 is mate!",
    "file": "voice/fishing-pole-trap/step-7-81dc8ada.mp3",
    "seconds": 3.331
   },
   "step-8": {
    "text": "White makes room for the king.",
    "file": "voice/fishing-pole-trap/step-8-f47d9394.mp3",
    "seconds": 1.418
   },
   "step-9": {
    "text": "Pawn to g3. Now nothing can stop mate.",
    "file": "voice/fishing-pole-trap/step-9-bedf2429.mp3",
    "seconds": 2.799
   },
   "step-10": {
    "text": "White tries anything...",
    "file": "voice/fishing-pole-trap/step-10-88284c55.mp3",
    "seconds": 1.152
   },
   "step-11": {
    "text": "Queen to h1. Checkmate!",
    "file": "voice/fishing-pole-trap/step-11-6aa24411.mp3",
    "seconds": 1.899
   },
   "finale": {
    "text": "Checkmate! Black wins.",
    "file": "voice/fishing-pole-trap/finale-bd5a32ad.mp3",
    "seconds": 1.369
   },
   "remember": {
    "text": "Remember!",
    "file": "voice/fishing-pole-trap/remember-267df169.mp3",
    "seconds": 0.633
   },
   "takeaway-0": {
    "text": "Taking the bait opens the h-file.",
    "file": "voice/fishing-pole-trap/takeaway-0-72b9e3eb.mp3",
    "seconds": 2.007
   },
   "takeaway-1": {
    "text": "Rook and queen on an open file means mate.",
    "file": "voice/fishing-pole-trap/takeaway-1-771eafa0.mp3",
    "seconds": 2.237
   },
   "takeaway-2": {
    "text": "Risky trap: It only works if they take the bait.",
    "file": "voice/fishing-pole-trap/takeaway-2-3399b34a.mp3",
    "seconds": 2.732
   },
   "cta": {
    "text": "Follow for more traps!",
    "file": "voice/fishing-pole-trap/cta-fd3186ce.mp3",
    "seconds": 1.326
   }
  },
  "siberian-trap": {
   "hook": {
