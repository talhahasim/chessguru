   },
   "step-4": {
    "text": "White pins our knight to the queen. Looks scary.",
    "file": "voice/stafford-trap/step-4-a57a9361.mp3",
    "seconds": 2.516
   },
   "step-5": {
    "text": "We move it anyway! Knight takes e4. Take my queen!",
    "file": "voice/stafford-trap/step-5-d1daffad.mp3",
